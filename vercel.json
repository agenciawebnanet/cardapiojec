{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/menu",
      "destination": "/api/handler?route=menu"
    },
    {
      "source": "/api/waiter-order",
      "destination": "/api/handler?route=waiter-order"
    },
    {
      "source": "/api/orders",
      "destination": "/api/handler?route=orders"
    },
    {
      "source": "/api/admin/:action",
      "destination": "/api/handler?route=admin/:action"
    },
    {
      "source": "/garcom",
      "destination": "/index.html"
    },
    {
      "source": "/painel",
      "destination": "/index.html"
    },
    {
      "source": "/mesa/:number",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "buildCommand": "npm run build"
}
